# Required. Paste your current complete RTSP URL including token. Never commit .env.
CAMERA_URL=
# Optional high-resolution recording stream; blank reuses CAMERA_URL.
# Use CAMERA_URL for the camera's low-resolution detection substream if available.
RECORDING_CAMERA_URL=
# Manual test-source marker. Pi publisher also writes automatic source metadata.
TEST_STREAM=false
# tcp recommended over UDP on Wi-Fi / Docker Desktop.
CAMERA_TRANSPORT=tcp
CAMERA_OPEN_TIMEOUT_SECONDS=8
CAMERA_READ_TIMEOUT_SECONDS=5
CAMERA_STALE_SECONDS=8
CAMERA_RECONNECT_MAX_SECONDS=30
# CSI host adapter (deploy/pi/source.py). Default: 1280x720, libcamera picks the sensor mode (IMX219:
# centre crop, ~39x22 deg). Full sensor (~62x49 deg): CAMERA_SIZE=1280x960 CAMERA_SENSOR_MODE=1640:1232:10:P
# - it wedged the camera pipeline twice on firmware 1.20230405, use only after a firmware/OS upgrade.
CAMERA_SIZE=1280x720
CAMERA_SENSOR_MODE=
# hardware = VideoCore H.264 encoder (cheapest); software = raw ISP frames + host FFmpeg x264 (~0.5-0.7
# core). On firmware 1.20230405 the hardware encoder hung the camera pipeline repeatedly; software ran
# stably (incl. the full-sensor mode). Needs ffmpeg with libx264 on the host.
CAMERA_ENCODER=hardware
# NoIR module (no infrared filter, ships with a blue gel square): imx219_noir fixes the colours.
CAMERA_TUNING_FILE=
# Initial clockwise rotation (0/90/180/270); the UI button overrides it and persists the choice.
CAMERA_ROTATION=0
# FFmpeg decoder for the camera stream; empty = software. Pi 4: use docker-compose.hwdecode.yml.
CAMERA_DECODER=
# docker-compose.stream.yml caps local-source reconnect at 2s.

# Motion gate: false runs AI continuously at AI_MAX_FPS (diagnostic mode).
MOTION_ENABLED=true
# Motion analysis only; camera decode, live stream and recording FPS stay unchanged.
MOTION_MAX_FPS=8
MOTION_MIN_AREA=3000
MOTION_THRESHOLD=25
MOTION_REQUIRED_FRAMES=3
MOTION_WARMUP_FRAMES=30
MOTION_COOLDOWN_SECONDS=10
MOTION_RESIZE_WIDTH=640
MOTION_HISTORY=500
MOTION_LEARNING_RATE=-1
MOTION_CROP_PADDING=0.35

# CPU in Mac Docker; native macOS can select MPS. CUDA requires a GPU-capable image/runtime.
AI_ENABLED=true
AI_BACKEND=ncnn
# Default Docker image bundles the Torch-free NCNN model (320 input, CPU).
# Native PyTorch development: AI_BACKEND=ultralytics; Docker: docker-compose.pytorch.yml.
# Empty inherits YAML model locally; Docker defaults to its bundled model.
AI_MODEL=
AI_DEVICE=auto
AI_CPU_THREADS=2
AI_TRACK_OBJECTS=person
AI_CONFIDENCE=0.75
# 0 = off. Between this and AI_CONFIDENCE: silent events (snapshot, clip, montage; no notification).
AI_RECORD_CONFIDENCE=0
AI_IMAGE_SIZE=320
AI_MAX_FPS=3
AI_CROP_MOTION=true
AI_VALIDATION_WINDOW=3
AI_VALIDATION_MIN_POSITIVE=2
AI_VALIDATION_MAX_GAP_SECONDS=5
# 0 = off. Otherwise one frame at least this confident triggers without waiting for a second.
AI_VALIDATION_INSTANT_CONFIDENCE=0
EVENT_COOLDOWN_SECONDS=30

# Optional activity captioning: person event -> separate 10s clip -> OpenRouter.
# No API key means this worker and clip capture stay disabled.
OPENROUTER_API_KEY=
# The last model is paid (~$0.0002 per clip); use only :free models to avoid OpenRouter charges.
ACTIVITY_LLM_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,qwen/qwen3.7-flash
ACTIVITY_LLM_TIMEOUT_SECONDS=75

# Person montage: frames from the first person event until motion ends, sent as one ntfy image.
MONTAGE_ENABLED=true
MONTAGE_INTERVAL_SECONDS=1
# Upper bound of tiles; long episodes are thinned evenly instead of growing.
MONTAGE_MAX_FRAMES=16
MONTAGE_MAX_SECONDS=300
# The montage closes after this long without motion; a return in the meantime continues it.
MONTAGE_IDLE_SECONDS=60

# Optional recorders. Missing switches behave as false. Only finalized video is uploaded.
RECORD_EVENTS=false
RECORD_CLIP_SECONDS=30
CONTINUOUS_RECORDING=false
RECORDING_SEGMENT_SECONDS=300
# Rolling 2s stream-copy segments; 0 disables pre-roll. Exact duration depends on keyframes.
RECORD_PRE_ROLL_SECONDS=5

# Local snapshots, thumbnails, clips, continuous recordings and event rows expire after this many days.
# Cloud backup is NOT deleted. Cleanup runs at startup and hourly; active files/uploads are protected.
RETENTION_DAYS=14
# Pause new media writes below this free space; never delete younger evidence to meet a quota.
MIN_FREE_DISK_MB=512

# Missing URL OR topic disables notification. Token optional for public ntfy topics.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
NOTIFICATION_COOLDOWN_SECONDS=60

# Missing remote OR path disables backup, even when BACKUP_ENABLED=true.
BACKUP_ENABLED=false
BACKUP_REMOTE=
BACKUP_PATH=
# Example remote: storage: ; path: camera-archive/pi4
DELETE_AFTER_UPLOAD=false
BACKUP_SCAN_SECONDS=30
# This is queue polling, not a recursive filesystem scan; reconciliation runs only at startup.
BACKUP_TIMEOUT_SECONDS=120
# Optional rclone config path; Compose default is /data/rclone/rclone.conf.
# RCLONE_CONFIG=/data/rclone/rclone.conf
# Native remote creation alternatively uses RCLONE_CONFIG_STORAGE_* environment variables.

# Embedded browser PLAYER page, e.g. http://0.0.0.0:8888/cam (HLS) or :8889/cam (WebRTC).
# 0.0.0.0 (or {host}) is replaced by the address the browser opened the UI with, so the same setting works
# on the LAN (192.168.x.y), over Tailscale and by name. A fixed IP only works where that IP is reachable.
# Empty displays 'Live stream unavailable'; detection and event UI keep working.
LIVE_STREAM_URL=
# Local MediaMTX WebRTC ICE addresses reachable by browsers (comma-separated IPs/DNS).
# WEBRTC_ADDITIONAL_HOSTS=pi.local,100.x.y.z
WEBRTC_ADDITIONAL_HOSTS=
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Docker host binding (not the Uvicorn address above).
# All host interfaces (LAN + tailnet): WEB_BIND_ADDRESS=0.0.0.0.
# No built-in authentication: do not expose this port to the public Internet.
WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=8000
# Raspberry Pi only: uncomment to expose the read-only Pi model file to diagnostics.
# COMPOSE_FILE=docker-compose.yml:docker-compose.pi.yml
# Pi local source: all Docker services in ONE Compose project (order matters).
# COMPOSE_FILE=docker-compose.yml:docker-compose.pi.yml:docker-compose.stream.yml:docker-compose.ncnn.yml
# Pi 4 with H.264 hardware decoding of the camera stream:
# COMPOSE_FILE=docker-compose.yml:docker-compose.pi.yml:docker-compose.hwdecode.yml:docker-compose.stream.yml:docker-compose.ncnn.yml
# Infinite test video; leave blank for real CSI camera + host adapter.
COMPOSE_PROFILES=
# COMPOSE_PROFILES=test-source

# Leave blank for ./data locally, /data in Compose. Docker DATA_DIR is fixed to /data.
DATA_DIR=
LOG_LEVEL=INFO
STATS_INTERVAL_SECONDS=30
TZ=Europe/Budapest
# Compose bind mount owner: Linux 'id -u' / 'id -g'; macOS defaults usually work.
APP_UID=1000
APP_GID=1000
